        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (span_name) (rate(traces_span_metrics_calls_total{service_name=\"demo-pedidos\", span_kind=\"SPAN_KIND_SERVER\", http_route=~\"$rota\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) or sum by (span_name) (rate(traces_span_metrics_calls_total{service_name=\"demo-pedidos\", span_kind=\"SPAN_KIND_SERVER\", http_route=~\"$rota\"}[$__rate_interval])) * 0) / sum by (span_name) (rate(traces_span_metrics_calls_total{service_name=\"demo-pedidos\", span_kind=\"SPAN_KIND_SERVER\", http_route=~\"$rota\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "B",
          "range": false,
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
