# Variáveis do compose NA VM (substitui o .env da raiz via --env-file .env.vm).
# O scripts/deploy-vm.sh cria o .env.vm na VM a partir deste modelo na primeira vez,
# com uma senha aleatória para o admin do Grafana. Ele não vai para o git.
APP_PORT=8090
GRAFANA_PORT=3101
DEMO_DOMAIN=demo.deploypro.com.br
GRAFANA_ADMIN_PASSWORD=
